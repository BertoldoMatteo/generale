<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="ASUS"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-10-17 04:44:03 "/>
        <attribute name="created" value="QVNVUztMQVBUT1AtUUEyREc0U0g7MjAyNS0xMC0xNzsiMDQ6MjI6MzcgIjsyNTU4"/>
        <attribute name="edited" value="QVNVUztMQVBUT1AtUUEyREc0U0g7MjAyNS0xMC0xNzsiMDQ6NDQ6MDMgIjsyOzI2NjQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, b1, n, i" type="Integer" array="False" size=""/>
            <output expression="&quot;Inserisci il numero di cifre di Fibonacci che vuoi visualizzare&quot;" newline="True"/>
            <input variable="n"/>
            <while expression="n&lt;=0">
                <output expression="&quot;Valore non valido&quot;" newline="True"/>
                <input variable="n"/>
            </while>
            <if expression="n==1">
                <then>
                    <output expression="&quot;0&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;0&quot;" newline="True"/>
                    <if expression="n==2">
                        <then>
                            <output expression="&quot;1&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;1&quot;" newline="True"/>
                            <assign variable="a" expression="0"/>
                            <assign variable="b" expression="1"/>
                            <for variable="n" start="n-1" end="2" direction="dec" step="1">
                                <assign variable="b1" expression="b+a"/>
                                <assign variable="a" expression="b"/>
                                <assign variable="b" expression="b1"/>
                                <output expression="&quot;&quot;&amp;b" newline="True"/>
                            </for>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
