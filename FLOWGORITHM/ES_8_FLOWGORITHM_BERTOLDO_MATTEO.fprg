<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="ASUS"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-10-08 03:39:15 "/>
        <attribute name="created" value="QVNVUztMQVBUT1AtUUEyREc0U0g7MjAyNS0xMC0wODsiMDM6MzE6MjUgIjsyNTU0"/>
        <attribute name="edited" value="QVNVUztMQVBUT1AtUUEyREc0U0g7MjAyNS0xMC0wODsiMDM6Mzk6MTUgIjsxOzI2Njk="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n1, n2, n3" type="Integer" array="False" size=""/>
            <output expression="&quot;Inserisci il primo numero&quot;" newline="True"/>
            <input variable="n1"/>
            <output expression="&quot;Inserisci il secondo numero&quot;" newline="True"/>
            <input variable="n2"/>
            <output expression="&quot;Inserisci il terzo numero&quot;" newline="True"/>
            <input variable="n3"/>
            <output expression="&quot;L'ordine crescente dei tre numeri &#232;: &quot;" newline="True"/>
            <if expression="n1&gt;=n2">
                <then>
                    <if expression="n1&gt;=n3">
                        <then>
                            <if expression="n2&gt;=n3">
                                <then>
                                    <output expression="n3 &amp; &quot; &quot; &amp; n2 &amp; &quot; &quot; &amp; n1" newline="True"/>
                                </then>
                                <else>
                                    <output expression="n2 &amp; &quot; &quot; &amp; n3 &amp; &quot; &quot; &amp; n1" newline="True"/>
                                </else>
                            </if>
                        </then>
                        <else>
                            <output expression="n2 &amp; &quot; &quot; &amp; n1 &amp; &quot; &quot; &amp; n3" newline="True"/>
                        </else>
                    </if>
                </then>
                <else>
                    <if expression="n1&gt;=n3">
                        <then>
                            <output expression="n3 &amp; &quot; &quot; &amp; n1 &amp; &quot; &quot; &amp; n2" newline="True"/>
                        </then>
                        <else>
                            <if expression="n2&gt;=n3">
                                <then>
                                    <output expression="n1 &amp; &quot; &quot; &amp; n3 &amp; &quot; &quot; &amp; n2" newline="True"/>
                                </then>
                                <else>
                                    <output expression="n1 &amp; &quot; &quot; &amp; n2 &amp; &quot; &quot; &amp; n3" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
